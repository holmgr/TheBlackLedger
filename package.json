{
  "name": "the-black-ledger",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bun --bun oxlint . --max-warnings=0",
    "lint:fix": "bun run lint --fix",
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun x --no-install tsc --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "packageManager": "bun@1.4.4"
}
